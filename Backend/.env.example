# ==========================================
# Food Saathi Backend - Environment Configuration Example
# ==========================================

# Server
PORT=5000
SOCKET_PORT=5001
HOST=0.0.0.0
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/foodsaathi
MONGO_ENV=local

# Authentication (JWT)
JWT_SECRET=your_jwt_secret_key_here
JWT_ACCESS_EXPIRES=365d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_REFRESH_EXPIRES=365d

# Cashfree Payment Gateway
# Read credentials only from environment variables.
# CASHFREE_ENV can be "sandbox" (for testing) or "production" (live)
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENV=sandbox

# OTP & SMS Service (SMS India Hub)
USE_DEFAULT_OTP=false
DEFAULT_OTP_CODE=123456
DEFAULT_OTP_TEST_PHONES=9999999999
SMS_INDIA_HUB_API_KEY=your_smsindiahub_api_key
SMS_INDIA_HUB_SENDER_ID=BGADPL
SMS_INDIA_HUB_CHANNEL=Trans
SMS_INDIA_HUB_DCS=0
SMS_INDIA_HUB_FLASH_SMS=0
SMS_INDIA_HUB_ENTITY_ID=1001164203633432409
SMS_INDIA_HUB_TEMPLATE_ID=1077104580057767222

# Firebase Push Notifications (Optional)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_SERVICE_ACCOUNT_PATH=path/to/firebase-service-account.json

# Redis (Optional)
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379

# Google Maps (Optional)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

